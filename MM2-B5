local function createToggle(name, posY, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(0, 480, 0, 48)
    container.Position = UDim2.new(0, 20, 0, posY)
    container.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    container.BorderSizePixel = 0
    container.Parent = MainWindow
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = container
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 380, 1, 0)
    label.Position = UDim2.new(0, 15, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamSemibold
    label.Text = name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container
    
    local switchBg = Instance.new("TextButton")
    switchBg.Size = UDim2.new(0, 48, 0, 26)
    switchBg.Position = UDim2.new(1, -60, 0.5, -13)
    switchBg.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    switchBg.Text = ""
    switchBg.Parent = container
    
    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(1, 0)
    switchCorner.Parent = switchBg
    
    local switchCircle = Instance.new("Frame")
    switchCircle.Size = UDim2.new(0, 20, 0, 20)
    switchCircle.Position = UDim2.new(0, 3, 0.5, -10)
    switchCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    switchCircle.Parent = switchBg
    
    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = switchCircle
    
    local toggled = false
    switchBg.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            TweenService:Create(switchBg, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(0, 180, 255)}):Play()
            TweenService:Create(switchCircle, TweenInfo.new(0.25), {Position = UDim2.new(1, -23, 0.5, -10)}):Play()
        else
            TweenService:Create(switchBg, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play()
            TweenService:Create(switchCircle, TweenInfo.new(0.25), {Position = UDim2.new(0, 3, 0.5, -10)}):Play()
        end
        callback(toggled)
    end)
end

-- ตัวแปรสถานะ
local espEnabled = false
local autoGunEnabled = false
local aimbotGunEnabled = false
local tpMurdererEnabled = false
local tpSheriffEnabled = false
local invisibleEnabled = false

-- 1. ESP ระบบเดิม
createToggle("👀 เปิด/ปิด ESP (ฆาตกร: แดง | นายอำเภอ:ขาว)", 55, function(state)
    espEnabled = state
    sendNotification("ESP", tostring(espEnabled))
end)

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local backpack = player.Backpack
            local char = player.Character
            local role = "Inno"
            
            if char:FindFirstChild("Knife") or backpack:FindFirstChild("Knife") then
                role = "Murderer"
            elseif char:FindFirstChild("Gun") or backpack:FindFirstChild("Gun") then
                role = "Sheriff"
            end
            
            local hl = char:FindFirstChild("VortexHighlight")
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "VortexHighlight"
                hl.Parent = char
            end
            
            if role == "Murderer" then
                hl.FillColor = Color3.fromRGB(255, 0, 0)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            elseif role == "Sheriff" then
                hl.FillColor = Color3.fromRGB(255, 255, 255)
                hl.OutlineColor = Color3.fromRGB(0, 0, 0)
            else
                hl.FillColor = Color3.fromRGB(0, 255, 0)
                hl.OutlineColor = Color3.fromRGB(0, 0, 0)
            end
        end
    end
end)

