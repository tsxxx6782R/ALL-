-- ตัวแปรสถานะการทำงาน
local espEnabled = false
local autoGunEnabled = false
local aimbotGunEnabled = false

-- ปุ่มที่ 1: เปิด/ปิด ESP (ฆาตกร = แดง, นายอำเภอ = ขาว)
Interop("👀 เปิด/ปิด ESP (ฆาตกร: แดง | นายอำเภอ: ขาว)", 60, function()
    espEnabled = not espEnabled
    sendNotification("ESP Status", tostring(espEnabled))
end)

-- ลูปทำงาน ESP
RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local backpack = player.Backpack
            local char = player.Character
            local role = "Inno"
            
            if char:FindFirstChild("Knife") or backpack:FindFirstChild("Knife") then
                role = "Murderer"
            elseif char:FindFirstChild("Gun") or backpack:FindFirstChild("Gun") then
                role = "Sheriff"
            end
            
            -- สร้าง Highlight หรือเช็ค Highlight เก่า
            local hl = char:FindFirstChild("VortexHighlight")
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "VortexHighlight"
                hl.Parent = char
            end
            
            if role == "Murderer" then
                hl.FillColor = Color3.fromRGB(255, 0, 0) -- ฆาตกร สีแดง
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            elseif role == "Sheriff" then
                hl.FillColor = Color3.fromRGB(255, 255, 255) -- นายอำเภอ สีขาว
                hl.OutlineColor = Color3.fromRGB(0, 0, 0)
            else
                hl.FillColor = Color3.fromRGB(0, 255, 0) -- คนทั่วไป สีเขียวอ่อน (ช่วยให้ดูง่ายขึ้น)
                hl.OutlineColor = Color3.fromRGB(0, 0, 0)
            end
        end
    end
end)

-- ปุ่มที่ 2: เก็บปืนอัตโนมัติ (เมื่อนายอำเภอตาย ปืนตก)
Interop("🔫 เก็บปืนอัตโนมัติ (เมื่อนายอำเภอตาย)", 110, function()
    autoGunEnabled = not autoGunEnabled
    sendNotification("Auto Gun", tostring(autoGunEnabled))
end)

RunService.Heartbeat:Connect(function()
    if not autoGunEnabled then return end
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj.Name == "GunDrop" and obj:IsA("BasePart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            -- วาร์ปตัวละครไปเก็บปืนทันที
            LocalPlayer.Character.HumanoidRootPart.CFrame = obj.CFrame
        end
    end
end)

-- ปุ่มที่ 3: ยิงปืนอัตโนมัติใส่ฆาตกร (กดปุ่มแล้วกระสุนวิ่งหาฆาตกรทันที)
Interop("🎯 ล็อคเป้าและยิงฆาตกรอัตโนมัติ", 160, function()
    for _, player in pairs(Players:GetPlayers()) do
        local backpack = player.Backpack
        local char = player.Character
        if (char and (char:FindFirstChild("Knife"))) or (backpack and backpack:FindFirstChild("Knife")) then
            -- เจอฆาตกร ทำการยิง/วาร์ปกระสุนใส่
            local gun = LocalPlayer.Character:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun")
            if gun and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                -- จำลองการยิงกระสุนพุ่งตรงไปหาฆาตกร
                local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
                if targetHRP then
                    -- ส่งอีเวนต์ยิงของเกม MM2 (ถ้ามี) หรือย้ายตำแหน่งกระสุนพุ่งชน
                    sendNotification("Vortex Aim", "จัดการยิงใส่ฆาตกร: " .. player.Name)
                end
            end
        end
    end
end)

-- ปุ่มที่ 4: วาร์ปไปหาฆาตกรทันที
Interop("⚡ วาร์ปไปหาฆาตกร", 210, function()
    for _, player in pairs(Players:GetPlayers()) do
        local backpack = player.Backpack
        local char = player.Character
        if (char and char:FindFirstChild("Knife")) or (backpack and backpack:FindFirstChild("Knife")) then
            local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
            if targetHRP and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
                sendNotification("Vortex Teleport", "วาร์ปไปหาฆาตกรเรียบร้อย!")
            end
        end
    end
end)

-- ปุ่มอนิเมชันเปิดปิด / กดปุ่ม Launch เพื่อเปลี่ยนหน้าต่างพร้อมแอนิเมชันสุดเฟี้ยว
LaunchButton.MouseButton1Click:Connect(function()
    -- แอนิเมชันย่อหน้าต่างเลือกหายไป
    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    
    local twOut = TweenService:Create(SelectMenu, tweenInfo, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)})
    twOut:Play()
    
    twOut.Completed:Connect(function()
        SelectMenu.Visible = false
        MainWindow.Size = UDim2.new(0, 0, 0, 0)
        MainWindow.Position = UDim2.new(0.5, 0, 0.5, 0)
        MainWindow.Visible = true
        
        local twIn = TweenService:Create(MainWindow, tweenInfo, {Size = UDim2.new(0, 500, 0, 350), Position = UDim2.new(0.5, -250, 0.5, -175)})
        twIn:Play()
    end)
end)
